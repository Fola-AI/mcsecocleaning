{
  "name": "mcsecocleaning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/check-price-parity.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:push": "tsx scripts/assert-dev-db.ts && prisma db push",
    "db:migrate": "tsx scripts/assert-dev-db.ts && prisma migrate dev",
    "db:deploy": "tsx scripts/assert-dev-db.ts && prisma migrate deploy",
    "db:seed": "tsx scripts/assert-dev-db.ts && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "tsx scripts/assert-dev-db.ts && prisma migrate reset",
    "check:launch-inputs": "tsx scripts/check-launch-inputs.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "inngest": "^4.19.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "rrule": "^2.8.1",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
