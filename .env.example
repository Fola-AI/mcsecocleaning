# ─────────────────────────────────────────────────────────────
# mcsecocleaning environment (§9.2 — no secrets in the repo)
# Copy to .env.local for development. Set real values in Vercel.
# ─────────────────────────────────────────────────────────────

# Public site origin (canonical URLs, sitemap, JSON-LD, llms.txt)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# VAT (§10.1) — ships false; flip to "true" once HMRC-registered. No migration.
VAT_REGISTERED="false"

# Database (Postgres — Neon/Supabase, eu-west-2) (§9)
DATABASE_URL="postgresql://user:password@localhost:5432/mcseco?schema=public"
# Prisma direct (non-pooled) URL for migrations, if using a pooler
DIRECT_URL=""

# Analytics — GA4 (loads only after cookie consent, §10.3)
NEXT_PUBLIC_GA_ID=""

# Email (Resend) — booking/lead notifications (§6.17). SPF/DKIM/DMARC required (§9.2)
RESEND_API_KEY=""
# Inbox that lead-form submissions are delivered to
LEADS_INBOX="hello@mcsecocleaning.co.uk"
EMAIL_FROM="mcsecocleaning <hello@mcsecocleaning.co.uk>"

# SMS (Twilio) — alphanumeric sender ID (§9)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SENDER_ID="mcseco"

# Stripe (Phase 2) — authorise at booking, capture on completion (§6.5)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Cloudflare R2 (Phase 5 — media) (§6.10, §9)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Inngest (durable scheduler/queue — §9.1)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Sentry (§9)
NEXT_PUBLIC_SENTRY_DSN=""

# Encryption key for property access codes at rest (§6.9) — 32-byte base64
ACCESS_CODE_ENC_KEY=""
