# ─────────────────────────────────────────────────────────────
# mcsecocleaning environment (§13 — no secrets in the repo)
#
# Copy to .env.local for development and fill it in — SETUP.md §4 is the
# annotated version of this file. Set real values in Vercel for deploys.
#
# Precedence note: .env.local wins over .env for both Next.js and (via
# prisma.config.ts) Prisma. If a stale .env is lying around with placeholder
# values, delete it rather than relying on precedence.
# ─────────────────────────────────────────────────────────────

# ── environment ──────────────────────────────────────────────
# APP_ENV gates outbound comms. ANYTHING other than "production" means every
# email goes to DEV_EMAIL_REDIRECT and every SMS to DEV_SMS_REDIRECT or the
# log (src/lib/outbound-guard.ts). Unset counts as non-production.
APP_ENV="development"

# Public site origin (canonical URLs, sitemap, JSON-LD, llms.txt)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The whole site ships noindex unless this is exactly "true". A production build
# on a real custom domain FAILS while it is off (src/lib/seo/indexing-guard.ts) —
# that is deliberate; flipping it is a LAUNCH.md step.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# VAT (§14.1) — ships false; flip to "true" once HMRC-registered. No migration.
VAT_REGISTERED="false"

# ── database: Neon, eu-west-2 (§13) ──────────────────────────
# DATABASE_URL is the pooled string (host contains -pooler); DIRECT_URL is the
# non-pooled one, used for migrations. Append &connect_timeout=15 to both.
DATABASE_URL="postgresql://user:password@localhost:5432/mcseco?schema=public"
DIRECT_URL=""

# The Neon DEV branch's DIRECT host (the ep-… part between @ and /). Every
# migrate, push, reset and seed is refused unless the connection string's host
# matches this (scripts/assert-dev-db.ts). Deny-by-default: unset = refuse.
# This is what stops the build touching any other database.
DEV_DB_HOST=""

# ── auth (§13) ───────────────────────────────────────────────
# npx auth secret  — or  openssl rand -base64 32
AUTH_SECRET=""

# ── analytics — GA4 (loads only after cookie consent, §14.4) ─
NEXT_PUBLIC_GA_ID=""

# ── email (Resend) — §10.3. SPF/DKIM/DMARC required (§13.3) ──
RESEND_API_KEY=""
EMAIL_FROM="mcsecocleaning <hello@mcsecocleaning.co.uk>"
# Inbox that lead-form submissions are delivered to
LEADS_INBOX="hello@mcsecocleaning.co.uk"
# Every email sent while APP_ENV !== "production" goes here instead of to the
# customer. Leave it blank and non-production email is logged, never sent.
DEV_EMAIL_REDIRECT=""

# ── sms (Twilio) — alphanumeric sender ID (§10.3, stage L9) ──
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SENDER_ID="mcseco"
# As DEV_EMAIL_REDIRECT, for SMS. A verified number on a Twilio trial account.
DEV_SMS_REDIRECT=""

# ── stripe (§8) — authorise at booking, capture on completion ─
# TEST keys only during the build. An sk_live_ key here is a hard stop.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── access codes (§9.3) — 32-byte base64 ─────────────────────
# openssl rand -base64 32
# The dev key only. The PRODUCTION key is generated at launch and kept in a
# password manager — losing it makes every stored alarm/lockbox code unreadable.
ACCESS_CODE_ENC_KEY=""

# ── media: Cloudflare R2, EU bucket (§9.4, stage L7) ─────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Signs the customer media links (JWT, 48h). openssl rand -base64 32
MEDIA_LINK_SECRET=""
# Media retention in months — SETUP.md decision D4, within 12–24 (§9.4).
MEDIA_RETENTION_MONTHS="12"

# ── inngest (durable scheduler/queue — §13.1) ────────────────
# Local dev needs no keys; the dev server runs unauthenticated.
INNGEST_DEV="1"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── monitoring (§13.3, stage L14) ────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ── optional ─────────────────────────────────────────────────
# Rate limiting (SETUP.md decision D5). Without these, a Postgres-backed
# limiter behind the same interface is used instead.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Cal.com link for commercial site surveys (§7.6, stage L11)
NEXT_PUBLIC_CALCOM_URL=""
# Google review deep link, once the Business Profile is verified (§10.1, L12)
GOOGLE_REVIEW_URL=""
